# Copy this file to .env.local (for the Vite dev server) and fill in real values.
# Never commit .env, .env.local, or any file containing real keys.

# FRONTEND (read by Vite) - currently unused directly by client code,
# kept for parity with the backend variable below.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# BACKEND (Vercel/Node serverless function, api/ask.ts) - required.
GEMINI_API_KEY=your_gemini_api_key_here
